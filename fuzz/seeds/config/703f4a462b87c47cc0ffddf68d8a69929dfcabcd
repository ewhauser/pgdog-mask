[general]
tag_source = "comment"

[[users]]
name = "admin"
roles = ["pii_admin"]

[[users]]
name = "support"
roles = ["support"]

[[policies]]
name = "ssn"
data_type = "text"
mask = "sql"
expression = "'XXX-XX-' || right(val, 4)"

[[policies.rules]]
roles = ["pii_admin"]
mask = "none"

[[policies.rules]]
roles = ["support"]
mask = "default"
search = "raw"

[[policies]]
name = "email"
data_type = "text"
mask = "email"

[[policies.rules]]
roles = ["pii_admin"]
mask = "none"

[[masked_columns]]
schema = "masking_e2e"
name = "users"
column = "ssn"
policy = "ssn"

[[masked_columns]]
schema = "masking_e2e"
name = "users"
column = "email"
policy = "email"

# Tagged with a column comment.
[[policies]]
name = "phone"
data_type = "text"
mask = "partial"
keep_suffix = 2

[[policies.rules]]
roles = ["pii_admin"]
mask = "none"

[[policies]]
name = "secret"
data_type = "text"
mask = "null"

[[policies.rules]]
roles = ["pii_admin"]
mask = "none"

[[tags]]
name = "pii.phone"
policy = "phone"

[[tags]]
name = "secret"
policy = "secret"

[[classifiers]]
schema = "masking_e2e"
column_regex = "secret_.*"
tag = "secret"

# Proxy masks: computed by the plugin on the results.
[[policies]]
name = "tax_id"
data_type = "text"
mask = "proxy"
proxy = "hmac_sha256"
options = { key_env = "PGDOG_MASK_E2E_HMAC_KEY", length = 16 }

[[policies.rules]]
roles = ["pii_admin"]
mask = "none"

[[policies]]
name = "card"
data_type = "character varying"
mask = "proxy"
proxy = "ff1"
options = { key_env = "PGDOG_MASK_E2E_FF1_KEY" }
fallback = "partial"
keep_suffix = 4

[[policies.rules]]
roles = ["pii_admin"]
mask = "none"

# test.increment is built with the test-masks feature.
[[policies]]
name = "balance"
data_type = "bigint"
mask = "proxy"
proxy = "test.increment"

[[policies.rules]]
roles = ["pii_admin"]
mask = "none"

[[masked_columns]]
schema = "masking_e2e"
name = "users"
column = "tax_id"
policy = "tax_id"

[[masked_columns]]
schema = "masking_e2e"
name = "users"
column = "card"
policy = "card"

[[masked_columns]]
schema = "masking_e2e"
name = "users"
column = "balance"
policy = "balance"
